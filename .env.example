# Copia in .env e personalizza. Le variabili già presenti nell'ambiente hanno la precedenza.

# Database PostgreSQL (vedi docker-compose.yml per un'istanza locale)
DATABASE_URL=postgres://tgi:tgi@localhost:5432/tenuta_grieci

# Identificazione verso i siti monitorati: una pagina o un indirizzo dove chi gestisce un sito può contattarvi
CONTACT_URL=
# USER_AGENT=TenutaGrieciIntelligence/0.1 (...)

# Raccolta (valori prudenti: una richiesta ogni 3 secondi per sito)
REQUEST_DELAY_MS=3000
REQUEST_TIMEOUT_MS=20000
COLLECT_MAX_PAGES=20

# AI — credenziali: ANTHROPIC_API_KEY oppure `ant auth login` (profilo locale)
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL_CLASSIFY=claude-haiku-5-5
AI_MODEL_STRATEGY=claude-opus-5-5
AI_CLASSIFY_LIMIT=50
AI_MONTHLY_BUDGET_USD=20

# Avvisi (Slack o Discord incoming webhook)
ALERT_WEBHOOK_URL=

# Controllo di salute
HEALTH_STALE_HOURS=48
HEALTH_FAILURE_THRESHOLD=3
